# --- Client-safe (Config type in Vercel, shipped to browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<...>

# --- SERVER-ONLY (Secret type in Vercel, NEVER use VITE_ prefix) ---
# Read only inside /api serverless functions.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>

# Lazada via RapidAPI (tmapi-tmapi-default / lazada-api).
# LAZADA_API_KEY = the X-RapidAPI-Key value from your RapidAPI app.
LAZADA_API_KEY=<...>
# Gateway base. If search 404s, adjust the path suffix to match your playground
# Code snippet URL, then redeploy. Auth headers auto-switch to X-RapidAPI-Key /
# X-RapidAPI-Host when the base contains "rapidapi".
LAZADA_API_BASE=https://lazada-api.p.rapidapi.com/lazada

# Supabase Edge Function secrets (configure in Supabase dashboard/CLI only).
# Never use the VITE_ prefix for a provider or service-role secret.
# AI_API_KEY=your-provider-secret
# AI_MODEL=provider-model-id
# AI_BASE_URL=https://api.openai.com/v1
# ALLOWED_ORIGINS=https://your-production-site.example

# Optional local-only demo authentication. Only honored in Vite development mode.
# VITE_ENABLE_DEMO_AUTH=true
